{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wilksu/dev-tool-images/master/catalog/v1/inventory.schema.json",
  "title": "dev-tool-images direct component inventory",
  "type": "object",
  "required": [
    "schema",
    "scope",
    "transitive_inventory",
    "components"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "scope": {
      "const": "direct"
    },
    "transitive_inventory": {
      "const": "published-sbom"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "component": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "package",
        "version",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "kind": {
          "enum": [
            "runtime",
            "go-module",
            "npm-package",
            "alpine-package",
            "release-binary",
            "source-build"
          ]
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)+([-+][0-9A-Za-z.-]+)?$"
        },
        "source": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "version_key": {
          "type": "string",
          "pattern": "^(tools|packages)\\.[a-z0-9_]+$"
        },
        "manifest": {
          "enum": [
            "package.json#dependencies",
            "package.json#devDependencies"
          ]
        },
        "install_target": {
          "type": "string",
          "minLength": 1
        },
        "executables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "buf_plugins": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^buf\\.build/[a-z0-9._-]+/[a-z0-9._-]+:v[0-9]+(\\.[0-9]+)+([-+][0-9A-Za-z.-]+)?$"
          }
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "source_revision_key": {
          "type": "string",
          "pattern": "^sources\\.[a-z0-9_]+$"
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "npm-package"
              }
            }
          },
          "then": {
            "required": ["manifest"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "go-module"
              }
            }
          },
          "then": {
            "required": ["version_key", "install_target", "executables"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": ["runtime", "alpine-package"]
              }
            }
          },
          "then": {
            "required": ["version_key"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "release-binary"
              }
            }
          },
          "then": {
            "required": ["version_key", "executables", "artifacts"]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "source-build"
              }
            }
          },
          "then": {
            "required": [
              "version_key",
              "executables",
              "source_revision",
              "source_revision_key"
            ]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "required": ["platform", "url", "sha256", "sha256_key"],
      "properties": {
        "platform": {
          "enum": ["linux/amd64", "linux/arm64"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "sha256_key": {
          "type": "string",
          "pattern": "^artifacts\\.[a-z0-9_]+$"
        }
      },
      "additionalProperties": false
    }
  }
}
